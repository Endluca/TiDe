# Gaea application non-secret runtime config.
#
# Copy this file outside Git, replace the REPLACE_WITH_* value, upload it
# as a Gaea configuration file, and mount it at:
#   /deployments/config/application.env
#
# Do not add passwords, JWT/API keys, database URLs with credentials, or any
# TIT_DTS_* setting. Those remain Gaea secret environment variables.

# ---------- Operations API ----------
APP_ENV=production
TIT_MIGRATION_MODE=false
TIT_ALLOWED_HOSTS=tide-camp-ops.test.51talk.biz
TIT_HEALTHCHECK_HOST=tide-camp-ops.test.51talk.biz
TIT_ALLOWED_ORIGINS=
TIT_TRUSTED_PROXY_IPS=REPLACE_WITH_INGRESS_IP_OR_CIDR
TIT_SESSION_TTL_HOURS=8
TIT_DB_POOL_SIZE=5
TIT_DB_MAX_OVERFLOW=2
TIT_DB_POOL_TIMEOUT_SECONDS=5
TIT_DB_POOL_RECYCLE_SECONDS=1800
TIT_DB_CONNECT_TIMEOUT_SECONDS=8
TIT_DB_LOCK_TIMEOUT_MS=5000
TIT_DB_IDLE_TRANSACTION_TIMEOUT_MS=60000
TIT_DB_STATEMENT_TIMEOUT_MS=30000
TIT_DB_APPLICATION_NAME=tit-growth-api
TIT_API_WORKERS=2
TIT_API_LIMIT_CONCURRENCY=8
TIT_API_KEEPALIVE_SECONDS=5
TIT_ARGON2_MAX_CONCURRENCY=2
TIT_LOGIN_RATE_LIMIT_ATTEMPTS=10
TIT_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
TIT_LOGIN_RATE_LIMIT_MAX_KEYS=10000
TIT_SLOW_REQUEST_MS=1000
AGENT_PROVIDER=deterministic
OPENAI_AGENT_MODEL=gpt-5.6-terra
AGENT_REASONING_EFFORT=low
AGENT_TIMEOUT_SECONDS=20

# ---------- Score and SourceWide workers ----------
TIT_SCORE_DB_POOL_SIZE=1
TIT_SCORE_DB_MAX_OVERFLOW=0
TIT_SCORE_DB_STATEMENT_TIMEOUT_MS=60000
TIT_SCORE_DB_APPLICATION_NAME=tit-growth-score-worker
TIT_SOURCE_WIDE_ENABLED=false
TIT_IRREVERSIBLE_QUALIFICATION_GRANTS_ENABLED=false
TIT_SOURCE_WORKER_EXPECTED_DATABASE=tide_system_test
TIT_SOURCE_WORKER_DB_POOL_SIZE=1
TIT_SOURCE_WORKER_DB_MAX_OVERFLOW=0
TIT_SOURCE_WORKER_DB_STATEMENT_TIMEOUT_MS=60000
TIT_SOURCE_WORKER_DB_APPLICATION_NAME=tit-growth-source-worker
TIT_SOURCE_WORKER_MAX_PENDING_AGE_SECONDS=900

# ---------- DTS domain / Outbox / favorite runtimes ----------
# Publish application only after READY_SINGLE_PIPELINE and after DOM/OVS have
# created their first checkpoints. Database URLs remain
# Gaea secret variables and are deliberately forbidden from this file.
TIT_V2_RUNTIME_ENABLED=true
TIT_V2_EXPECTED_DATABASE=tide_system_test
TIT_V2_RUNTIME_BATCH_SIZE=25
TIT_V2_DOMAIN_LEASE_SECONDS=120
TIT_V2_TIME_RECHECK_LEASE_SECONDS=120

# ---------- Teacher API and Web ----------
TIDE_TEACHER_NODE_ENV=production
TIDE_TEACHER_HOST=tide.51talk.com
LOG_LEVEL=info
# Leave empty to reuse TIT_TRUSTED_PROXY_IPS.
TIDE_TRUSTED_PROXY_CIDRS=
TRUST_PROXY_HOPS=1
CORS_ORIGINS=https://tide.51talk.com
DATABASE_REQUIRED=true
DATABASE_MAX_CONNECTIONS=5
DATABASE_CONNECTION_TIMEOUT_MS=3000
DATABASE_STATEMENT_TIMEOUT_MS=10000
SHIWEN_READ_MODE=DIRECT_TABLES
SHIWEN_ALLOW_TIDE_FIXTURE_FALLBACK=false
# SHIWEN_TEACHER_IDENTITY_VIEW is only required when SHIWEN_READ_MODE=VIEWS.
PUBLIC_APP_URL=https://tide.51talk.com
PUBLIC_API_URL=https://tide.51talk.com
TEACHER_AUTH_MODE=HYBRID
CRM_SSO_ISSUER=crm
CRM_SSO_AUDIENCE=tide
CRM_SSO_MAX_TTL_SECONDS=120
CRM_SSO_CLOCK_TOLERANCE_SECONDS=30
CRM_SSO_EXCHANGE_TTL_SECONDS=60
CRM_ENTRY_URL=
ALLOWED_EMAIL_DOMAINS=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_MINUTES=60

# ---------- External integrations ----------
KUOZHI_LOGIN_URL=https://edu.51talk.com/login/ticket
KUOZHI_COURSE_URL=https://edu.51talk.com
KUOZHI_COURSE_CONFIG_PATH=./config/kuozhi-courses.json
KUOZHI_DETAIL_URL=http://edu.51talk.me/api/me/TeacherCourseDetail
KUOZHI_DETAIL_HOST_IP=172.16.0.54
KUOZHI_DETAIL_TIMEOUT_MS=8000
KUOZHI_DETAIL_RETRY_COUNT=1
MAIL_DELIVERY_PROVIDER=UNAVAILABLE
MAIL_API_URL=
MAIL_API_USER_ID=1
MAIL_API_APP_NAME=email
MAIL_API_USER_TYPE=1
MAIL_API_LANG=arr
MAIL_API_TIMEOUT_MS=10000
MAIL_VERIFY_TEMPLATE_ID=verify-email
MAIL_PASSWORD_RESET_TEMPLATE_ID=reset-password
MODELARK_ENABLED=false
MODELARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
MODELARK_MODEL=seed-2-0-lite-260228
MODELARK_TIMEOUT_MS=30000

# ---------- Storage and background jobs ----------
FILE_STORAGE_PROVIDER=OSS
LOCAL_FILE_STORAGE_DIR=/var/lib/tide/uploads
OSS_REGION=oss-ap-southeast-1
OSS_ENDPOINT=https://oss-ap-southeast-1.aliyuncs.com
OSS_BUCKET=eff-new-teacher-camp
OSS_TIMEOUT_MS=30000
CDN_REGION_ID=ap-southeast-1
# The CDN API endpoint already defaults to the reviewed ap-southeast-1 endpoint.
MULTIPART_UPLOAD_MAX_CONCURRENCY=4
# FILE_UPLOAD_MAX_BYTES is fixed to 10485760 by the application image.
FILE_UPLOAD_TTL_MINUTES=15
FILE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf
BACKGROUND_JOBS_ENABLED=true
BACKGROUND_JOB_LEASE_MS=180000
SYSTEM_NOTIFICATION_PUBLISHER_ENABLED=false
SYSTEM_NOTIFICATION_CONFIG_PATH=./config/system-notifications.json
SYSTEM_NOTIFICATION_POLL_INTERVAL_MS=60000
SYSTEM_NOTIFICATION_BATCH_SIZE=20
PERSONALIZED_TASK_NOTIFICATION_SCHEDULER_ENABLED=false
PERSONALIZED_TASK_NOTIFICATION_ROLLOUT_AT=
PERSONALIZED_TASK_NOTIFICATION_POLL_INTERVAL_MS=300000
GROWTH_STAGE_NOTIFICATION_SCHEDULER_ENABLED=false
GROWTH_STAGE_NOTIFICATION_POLL_INTERVAL_MS=300000
SUPPORT_TICKET_CLEANUP_POLL_INTERVAL_MS=60000
SUPPORT_TICKET_CLEANUP_BATCH_SIZE=20
TASK_CATALOG_PUBLIC_WRITE=false

# Keep these as Gaea environment variables, using the platform's secret mode:
#   TIT_PROCESS_PROFILE=application
#   TIT_RUNTIME_ENV_FILE=/deployments/config/application.env
#   DATABASE_URL
#   TIT_V2_DOMAIN_DATABASE_URL
#   TIT_V2_OUTBOX_DATABASE_URL
#   TIT_V2_FAVORITE_DATABASE_URL
#   TIDE_DATABASE_URL
#   SHIWEN_READ_DATABASE_URL
#   DATA_HASH_SECRET
#   AUTH_JWT_SECRET
#   CRM_SSO_JWT_SECRET_CURRENT
#   CRM_SSO_JWT_SECRET_PREVIOUS (only during rotation)
#   KUOZHI_APP_KEY
#   KUOZHI_SECRET_KEY
#   MAIL_API_ACCESS_KEY (only when mail delivery is enabled)
#   OSS_ACCESS_KEY_ID
#   OSS_ACCESS_KEY_SECRET
#   CDN_ACCESS_KEY_ID
#   CDN_ACCESS_KEY_SECRET
#   ARK_API_KEY (only when ModelArk is enabled)
#   OPENAI_API_KEY (only when the OpenAI agent provider is enabled)
