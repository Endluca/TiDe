# syntax=docker/dockerfile:1.7

FROM postgres:16.14-alpine

RUN apk add --no-cache bash ca-certificates coreutils \
    && addgroup -S -g 10001 tide_migration \
    && adduser -S -D -H -u 10001 -G tide_migration tide_migration

WORKDIR /workspace

COPY --chown=10001:10001 database/migrations/ ./database/migrations/
COPY --chown=10001:10001 database/scripts/apply-production.sh ./database/scripts/apply-production.sh

RUN chmod 0555 ./database/scripts/apply-production.sh \
    && find ./database/migrations -type f -exec chmod 0444 {} +

USER 10001:10001

ENTRYPOINT ["bash", "/workspace/database/scripts/apply-production.sh"]
