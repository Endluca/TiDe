NODE_ENV=development
BIND_HOST=0.0.0.0
PORT=3000
# 本地直连为 0；联合生产由 Edge 清洗为单值 XFF 后固定为 1。
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_REQUIRED=false
DATABASE_MAX_CONNECTIONS=10
DATABASE_CONNECTION_TIMEOUT_MS=3000
DATABASE_STATEMENT_TIMEOUT_MS=10000
# 生产环境两个连接都必须显式且仅配置一次 sslmode=verify-full。
TIDE_DATABASE_URL=postgresql://tit_teacher_crud:change_me@127.0.0.1:55432/tide_dev
SHIWEN_READ_DATABASE_URL=postgresql://tide_app:change_me@127.0.0.1:55432/tide_dev
SHIWEN_READ_MODE=VIEWS
SHIWEN_ALLOW_TIDE_FIXTURE_FALLBACK=false
SHIWEN_TEACHER_IDENTITY_VIEW=tide_mock_source.teacher_identity_v1
SYSTEM_NOTIFICATION_PUBLISHER_ENABLED=false
SYSTEM_NOTIFICATION_CONFIG_PATH=./config/system-notifications.json
SYSTEM_NOTIFICATION_POLL_INTERVAL_MS=60000
SYSTEM_NOTIFICATION_BATCH_SIZE=20
PERSONALIZED_TASK_NOTIFICATION_SCHEDULER_ENABLED=false
# 首次启用必须填写带时区的明确时间，例如 2026-07-24T15:00:00+08:00
PERSONALIZED_TASK_NOTIFICATION_ROLLOUT_AT=
PERSONALIZED_TASK_NOTIFICATION_POLL_INTERVAL_MS=300000
GROWTH_STAGE_NOTIFICATION_SCHEDULER_ENABLED=false
GROWTH_STAGE_NOTIFICATION_POLL_INTERVAL_MS=300000
SUPPORT_TICKET_CLEANUP_POLL_INTERVAL_MS=60000
SUPPORT_TICKET_CLEANUP_BATCH_SIZE=20
PUBLIC_APP_URL=http://localhost:5173
ALLOWED_EMAIL_DOMAINS=
EMAIL_VERIFICATION_TTL_MINUTES=60
MAIL_DELIVERY_PROVIDER=UNAVAILABLE
MAIL_API_URL=
MAIL_API_ACCESS_KEY=
MAIL_API_USER_ID=1
MAIL_API_APP_NAME=email
MAIL_API_USER_TYPE=1
MAIL_API_LANG=arr
MAIL_API_TIMEOUT_MS=10000
MAIL_VERIFY_TEMPLATE_ID=verify-email
DATA_HASH_SECRET=
AUTH_JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30
MAIL_PASSWORD_RESET_TEMPLATE_ID=reset-password
PUBLIC_API_URL=http://localhost:3000
# 生产环境必须使用 OSS；LOCAL 只允许本地开发和隔离测试。
FILE_STORAGE_PROVIDER=LOCAL
LOCAL_FILE_STORAGE_DIR=./storage/private
OSS_REGION=oss-ap-southeast-1
OSS_ENDPOINT=https://oss-ap-southeast-1.aliyuncs.com
OSS_BUCKET=eff-new-teacher-camp
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_TIMEOUT_MS=30000
PUBLIC_ASSET_OSS_REGION=oss-ap-southeast-1
PUBLIC_ASSET_OSS_ENDPOINT=https://oss-ap-southeast-1.aliyuncs.com
PUBLIC_ASSET_OSS_BUCKET=eff-new-teacher-camp
PUBLIC_ASSET_BASE_URL=https://eff-new-teacher-camp.oss-ap-southeast-1.aliyuncs.com
PUBLIC_ASSET_CDN_BASE_URL=https://tide-media.51talkjr.com
CDN_ACCESS_KEY_ID=
CDN_ACCESS_KEY_SECRET=
CDN_REGION_ID=ap-southeast-1
CDN_API_ENDPOINT=cdn.ap-southeast-1.aliyuncs.com
VIDEO_PREFETCH_STATE_DIR=./storage/video-prefetch-runs
FILE_UPLOAD_MAX_BYTES=10485760
# 进程级 multipart 内存门禁；必须保持在 1-16。1 GiB 容器建议保持默认 4。
MULTIPART_UPLOAD_MAX_CONCURRENCY=4
FILE_UPLOAD_TTL_MINUTES=15
FILE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf
BACKGROUND_JOBS_ENABLED=true
BACKGROUND_JOB_LEASE_MS=180000
TEACHER_PHOTO_WORKER_POLL_INTERVAL_MS=1000
TEACHER_PHOTO_WORKER_BATCH_SIZE=2
TEACHER_PHOTO_WORKER_LEASE_MS=120000
AI_GATEWAY_ENABLED=false
AI_GATEWAY_CHAT_URL=https://aigateway.51talk.com/v1/chat/completions
AI_GATEWAY_UPLOAD_URL=https://aigateway.51talk.com/v1/task/sync
AI_GATEWAY_API_KEY=
AI_GATEWAY_PROVIDER=VOLCENGINE
AI_GATEWAY_MODEL=doubao-seed-2-0-lite
AI_GATEWAY_BIZ_ID=8218469790818477355
AI_GATEWAY_BIZ_TYPE=NTT_CE_PRS
AI_GATEWAY_UPLOAD_BUCKET=ai-efficiency-center
AI_GATEWAY_UPLOAD_PROVIDER=GOOGLE
AI_GATEWAY_TIMEOUT_MS=30000
