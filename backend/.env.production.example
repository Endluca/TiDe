# Production runtime example. Copy values through the deployment platform's
# secret/config manager; never commit a populated production file.
APP_ENV=production
DATABASE_URL=postgresql+psycopg://tit_growth_app:REPLACE_ME@postgres.example.internal:5432/tit_growth?sslmode=verify-full

# 前端通过同域 /api 反向代理访问后端，API 收到的 Host 仍是 Web App 域名。
# 多个生产域名使用英文逗号分隔。
TIT_ALLOWED_HOSTS=tit-growth.example.com

# 同域部署无需 CORS；若前后端跨域部署，再填写前端完整 HTTPS Origin。
TIT_ALLOWED_ORIGINS=

TIT_SESSION_TTL_HOURS=8
