# Production runtime-only example for API and score settlement. Never reuse
# this file for Alembic. Copy values through the deployment platform's
# secret/config manager; never commit a populated production file.
APP_ENV=production
TIT_MIGRATION_MODE=false
DATABASE_URL=postgresql+psycopg://tit_growth_app:REPLACE_ME@postgres.example.internal:5432/tit_growth?sslmode=verify-full
TIT_SOURCE_WORKER_EXPECTED_DATABASE=tit_growth
# 唯一新链路使用 Domain/Outbox/Favorite，旧 SourceWide Worker 保持关闭。
TIT_SOURCE_WIDE_ENABLED=false
# 上线抽样通过前保持 false；只控制新资格授予，不停止积分和当前门槛刷新。
TIT_IRREVERSIBLE_QUALIFICATION_GRANTS_ENABLED=false
# SourceWide Outbox 已到执行时间后仍为 PENDING 的最大健康容忍秒数。
TIT_SOURCE_WORKER_MAX_PENDING_AGE_SECONDS=900

# DOM/OVS 均产生新 checkpoint 后再发布 application。不要复用 DATABASE_URL。
TIT_V2_RUNTIME_ENABLED=true
TIT_V2_EXPECTED_DATABASE=tit_growth
TIT_V2_RUNTIME_BATCH_SIZE=25
TIT_V2_DOMAIN_LEASE_SECONDS=120
TIT_V2_TIME_RECHECK_LEASE_SECONDS=120
TIT_V2_DOMAIN_DATABASE_URL=postgresql+psycopg://tit_dts_domain_projector_runtime:REPLACE_ME@postgres.example.internal:5432/tit_growth?sslmode=verify-full
TIT_V2_OUTBOX_DATABASE_URL=postgresql+psycopg://tit_dts_outbox_worker_runtime:REPLACE_ME@postgres.example.internal:5432/tit_growth?sslmode=verify-full
TIT_V2_FAVORITE_DATABASE_URL=postgresql+psycopg://tit_dts_outbox_worker_runtime:REPLACE_ME@postgres.example.internal:5432/tit_growth?sslmode=verify-full

# 前端通过同域 /api 反向代理访问后端，API 收到的 Host 仍是 Web App 域名。
# 多个生产域名使用英文逗号分隔。
TIT_ALLOWED_HOSTS=tit-growth.example.com
# Docker 健康检查必须使用 Allowed Hosts 中的同一业务域名。
TIT_HEALTHCHECK_HOST=tit-growth.example.com

# 同域部署无需 CORS；若前后端跨域部署，再填写前端完整 HTTPS Origin。
TIT_ALLOWED_ORIGINS=

TIT_SESSION_TTL_HOURS=8
TIT_DB_CONNECT_TIMEOUT_SECONDS=8
TIT_DB_LOCK_TIMEOUT_MS=5000
TIT_DB_IDLE_TRANSACTION_TIMEOUT_MS=60000
TIT_DB_STATEMENT_TIMEOUT_MS=30000
TIT_ARGON2_MAX_CONCURRENCY=2
TIT_LOGIN_RATE_LIMIT_ATTEMPTS=10
TIT_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
TIT_LOGIN_RATE_LIMIT_MAX_KEYS=10000
TIT_SLOW_REQUEST_MS=1000
TIT_API_WORKERS=2
TIT_API_LIMIT_CONCURRENCY=8
TIT_API_KEEPALIVE_SECONDS=5

# 每个进程的连接池预算由 docker-compose.production.yml 按 API/结算进程分别注入。
# 若不使用该 Compose，部署平台必须显式注入以下四项。
TIT_DB_POOL_SIZE=5
TIT_DB_MAX_OVERFLOW=2
TIT_DB_POOL_TIMEOUT_SECONDS=5
TIT_DB_POOL_RECYCLE_SECONDS=1800
