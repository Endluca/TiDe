# Overseas DTS-ingest Gaea project. This file contains no passwords.
# TIT_DTS_PASSWORD and TIT_DTS_INGEST_DB_PASSWORD must be injected as two
# separate sensitive environment variables in this project's Gaea settings.
TIT_PROCESS_PROFILE=dts-ingest

TIT_DTS_SOURCE_REGION=ovs
TIT_DTS_EXECUTION_REGION=sg
TIT_DTS_BROKER_URL=100.103.7.163:18003
TIT_DTS_TOPIC=ap_southeast_1_vpc_pc_gs5986x4885426aej_dba_tide_source_ovs_version2
# Copy the system-generated Consumer Group ID from DTS "Consume Data".
# Do not use the editable consumer-group name. This value is deliberately empty.
TIT_DTS_GROUP_ID=
TIT_DTS_ACCOUNT=titconsumeovs
TIT_DTS_START_AT=2026-08-10T14:16:00+08:00
TIT_DTS_PASSWORD=

# Only teachers whose domestic status_on_time is on or after this Beijing-date
# boundary are materialized.  Leave END unset for the open-ended new-teacher
# population; both region projects must use the same values.
TIT_DTS_COHORT_START=2026-08-13
TIT_DTS_COHORT_END_EXCLUSIVE=
# Keep false while both topics catch up and reference-data readiness is checked.
# This overseas project is the only permitted projection owner after both
# regional checkpoints pass the activation gate.
TIT_DTS_PROJECTION_ENABLED=false
# One poison key stops the projector after this many attempts. A later source
# event for the key starts a fresh retry cycle.
TIT_DTS_PROJECTION_MAX_ATTEMPTS=8
# Required only when projection is enabled. Set one shared, timezone-bearing
# activation instant after both topics have caught up to that source time.
TIT_DTS_ACTIVATION_AT=
TIT_DTS_REQUIRED_OVS_TOPIC=ap_southeast_1_vpc_pc_gs5986x4885426aej_dba_tide_source_ovs_version2
TIT_DTS_REQUIRED_DOM_TOPIC=cn_beijing_vpc_pc_2ze5w28lmdr8f626y_dba_tide_source_dom_version2

TIT_DTS_INGEST_DB_HOST=tide-system.rwlb.singapore.rds.aliyuncs.com
TIT_DTS_INGEST_DB_PORT=5432
TIT_DTS_INGEST_DB_NAME=tide_system_test
TIT_DTS_INGEST_DB_SCHEMA=public
TIT_DTS_INGEST_DB_USER=tit_dts_ingest_runtime
# Production-safe default. For the current PRE ssl=off exception, apply the
# separate dts-ingest.pre-ssl-off.env.example override explicitly in Gaea.
TIT_DTS_INGEST_DB_SSLMODE=verify-full
TIT_DTS_ALLOW_INSECURE_DB=false
TIT_DTS_INGEST_DB_PASSWORD=
