# Generic dedicated Gaea DTS-ingest profile. Copy values from exactly one of
# the region-specific examples. One process must consume one subscription only.
# Keep this file non-secret; inject runtime secrets through Gaea's
# secret/sensitive environment-variable UI.
TIT_PROCESS_PROFILE=dts-ingest
TIT_DTS_TRANSPORT=official_java
# Legacy V1 remains the fail-safe default. Enable the exact database control
# mode only after H0 bootstrap and the complete source-profile manifest pass.
TIT_DTS_PIPELINE_MODE=V1
# Required only for V1_COMPAT_DUAL_CAPTURE. The epoch is route-specific; the
# control group is the shared fleet/bootstrap identity, not the DTS sid below.
TIT_DTS_V2_SOURCE_PARTITION_EPOCH_ID=
TIT_DTS_V2_CONTROL_GROUP=

TIT_DTS_SOURCE_REGION=
# Required placement declaration: ovs=sg, dom=cn. It must match the actual
# Gaea data center selected for this project.
TIT_DTS_EXECUTION_REGION=
TIT_DTS_BROKER_URL=
TIT_DTS_TOPIC=
TIT_DTS_GROUP_ID=
TIT_DTS_ACCOUNT=
TIT_DTS_START_AT=
# kafka_python fallback-probe-only diagnostics. They are not passed to the
# official_java transport used by the Gaea image.
TIT_DTS_KAFKA_STARTUP_REQUEST_TIMEOUT_MS=15000
TIT_DTS_KAFKA_STARTUP_API_VERSION_AUTO_TIMEOUT_MS=15000
TIT_DTS_PASSWORD=
# Required only for dom: generate 32 random bytes with a CSPRNG, encode them as
# exactly 64 lowercase hex characters, inject as sensitive, and never copy to ovs.
TIT_DTS_DOM_STUDENT_HMAC_PASSWORD=

# Confirmed OBS cohort window. The end is exclusive.
TIT_DTS_COHORT_START=2026-08-13
TIT_DTS_COHORT_END_EXCLUSIVE=
TIT_DTS_PROJECTION_ENABLED=false
# Quarantine one unchanged dirty key after this many attempts without stopping
# the projector; a later source event starts a fresh retry cycle.
TIT_DTS_PROJECTION_MAX_ATTEMPTS=8
# Required only when TIT_DTS_PROJECTION_ENABLED=true.
TIT_DTS_ACTIVATION_AT=
TIT_DTS_REQUIRED_OVS_TOPIC=
TIT_DTS_REQUIRED_DOM_TOPIC=

TIT_DTS_INGEST_DB_HOST=tide-system.rwlb.singapore.rds.aliyuncs.com
TIT_DTS_INGEST_DB_PORT=5432
TIT_DTS_INGEST_DB_NAME=tide_system_test
TIT_DTS_INGEST_DB_SCHEMA=public
TIT_DTS_INGEST_DB_USER=tit_dts_ingest_runtime
# Production-safe default. The current PRE-only ssl=off exception is kept in
# dts-ingest.pre-ssl-off.env.example and must not be copied to production.
TIT_DTS_INGEST_DB_SSLMODE=verify-full
TIT_DTS_ALLOW_INSECURE_DB=false
TIT_DTS_INGEST_DB_PASSWORD=
