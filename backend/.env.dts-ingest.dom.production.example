# Domestic DTS-ingest Gaea project. This file contains no passwords.
# TIT_DTS_PASSWORD and TIT_DTS_INGEST_DB_PASSWORD must be injected as two
# separate sensitive environment variables in this project's Gaea settings.
TIT_PROCESS_PROFILE=dts-ingest

TIT_DTS_SOURCE_REGION=dom
# Fail closed unless this consumer is deployed in the approved China runtime.
TIT_DTS_EXECUTION_REGION=cn
TIT_DTS_BROKER_URL=dts-cn-beijing-vpc.aliyuncs.com:18003
TIT_DTS_TOPIC=cn_beijing_vpc_pc_2ze5w28lmdr8f626y_dba_tide_source_dom_version2
TIT_DTS_GROUP_ID=tit-dom-group
TIT_DTS_ACCOUNT=titconsumedom
# Confirmed domestic subscription boundary, Beijing time (UTC+08:00).
TIT_DTS_START_AT=2026-08-12T16:30:00+08:00
TIT_DTS_PASSWORD=
# Domestic-only 32-byte CSPRNG secret encoded as exactly 64 lowercase hex
# characters. It HMAC-protects student IDs before any overseas PostgreSQL
# parameter is constructed. Never inject it into OVS.
TIT_DTS_DOM_STUDENT_HMAC_KEY=

# Keep identical to the overseas project.  The population is open-ended and
# starts with teachers whose domestic status_on_time is 2026-08-13 or later.
TIT_DTS_COHORT_START=2026-08-13
TIT_DTS_COHORT_END_EXCLUSIVE=
# Keep false while both topics catch up and reference-data readiness is checked.
# Domestic is ingest-only. Projection is owned by the overseas project after
# both checkpoints pass the activation gate.
TIT_DTS_PROJECTION_ENABLED=false
# One poison key stops the projector after this many attempts. A later source
# event for the key starts a fresh retry cycle.
TIT_DTS_PROJECTION_MAX_ATTEMPTS=8
# Required only when projection is enabled. Set exactly the same activation
# instant and required topics in the overseas and domestic projects.
TIT_DTS_ACTIVATION_AT=
TIT_DTS_REQUIRED_OVS_TOPIC=ap_southeast_1_vpc_pc_gs5986x4885426aej_dba_tide_source_ovs_version2
TIT_DTS_REQUIRED_DOM_TOPIC=cn_beijing_vpc_pc_2ze5w28lmdr8f626y_dba_tide_source_dom_version2

TIT_DTS_INGEST_DB_HOST=tide-system.rwlb.singapore.rds.aliyuncs.com
TIT_DTS_INGEST_DB_PORT=5432
TIT_DTS_INGEST_DB_NAME=tide_system_test
TIT_DTS_INGEST_DB_SCHEMA=public
TIT_DTS_INGEST_DB_USER=tit_dts_ingest_runtime
# Domestic-to-overseas writes require authenticated TLS even in PRE. Never
# apply dts-ingest.pre-ssl-off.env.example to the domestic project.
TIT_DTS_INGEST_DB_SSLMODE=verify-full
TIT_DTS_ALLOW_INSECURE_DB=false
TIT_DTS_INGEST_DB_PASSWORD=
