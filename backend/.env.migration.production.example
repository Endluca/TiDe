# Production migration-only example. The role must be exactly
# tit_growth_migrator and must not be used by API or worker containers.
# APP_ENV, TIT_MIGRATION_MODE and TIT_MIGRATION_EXPECTED_DATABASE are injected
# by docker-compose.production.yml so this file only carries the migration URL.
DATABASE_URL=postgresql+psycopg://tit_growth_migrator:REPLACE_ME@postgres.example.internal:5432/tit_growth?sslmode=verify-full
