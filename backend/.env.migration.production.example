# Production migration-only example. Schema changes use the existing
# tide_sys_admin account and must not reuse an application runtime credential.
# APP_ENV, TIT_MIGRATION_MODE and TIT_MIGRATION_EXPECTED_DATABASE are injected
# by docker-compose.production.yml so this file only carries the migration URL.
DATABASE_URL=postgresql+psycopg://tide_sys_admin:REPLACE_ME@postgres.example.internal:5432/tit_growth?sslmode=verify-full
