# Dedicated one-off source-scope coordinator. Inject the real database URL as
# a deployment-platform secret; never commit or print it.
TIT_DTS_SCOPE_COORDINATOR_DATABASE_URL=

# Stable, non-secret operator/automation identity. Retries of one candidate
# must use the same owner.
TIT_DTS_SCOPE_COORDINATOR_OWNER=tit-dts-scope-coordinator-production

TIT_DTS_SCOPE_COORDINATOR_LEASE_SECONDS=300
TIT_DTS_SCOPE_COORDINATOR_STAGE_BATCH_SIZE=100

# Reviewed artifacts and their independently published raw-file hashes.
TIT_DTS_SCOPE_CANDIDATE_PATH=/deployments/evidence/source-snapshot.jsonl
TIT_DTS_SCOPE_CANDIDATE_FILE_SHA256=
TIT_DTS_SCOPE_PROFILE_MANIFEST_PATH=/deployments/evidence/dts_source_profiles_v2.json
TIT_DTS_SCOPE_PROFILE_MANIFEST_SHA256=
