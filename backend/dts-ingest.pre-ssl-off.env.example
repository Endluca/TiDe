# Explicit, temporary PRE-only override for the approved endpoint
# tide-system.rwlb.singapore.rds.aliyuncs.com:5432 / tide_system_test.
# DMS SHOW ssl currently returns off. Apply both values together only to the
# overseas or domestic DTS PRE project that uses this exact private-line target.
# This is a non-TLS connection: the private line limits network exposure but
# does not encrypt PostgreSQL traffic. Production must remain verify-full.
# Delete this override as soon as server TLS is enabled.
TIT_DTS_INGEST_DB_SSLMODE=disable
TIT_DTS_ALLOW_INSECURE_DB=true
