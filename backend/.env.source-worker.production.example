# Dedicated SourceWide Worker runtime. Store the real file outside Git.
APP_ENV=production
TIT_MIGRATION_MODE=false
TIT_SOURCE_WORKER_DATABASE_URL=postgresql+psycopg://tit_source_worker_runtime:REPLACE_ME@postgres.example.internal:5432/tit_growth?sslmode=verify-full
TIT_SOURCE_WORKER_EXPECTED_DATABASE=tit_growth
TIT_DB_CONNECT_TIMEOUT_SECONDS=8
TIT_DB_LOCK_TIMEOUT_MS=5000
TIT_DB_IDLE_TRANSACTION_TIMEOUT_MS=60000
TIT_DB_STATEMENT_TIMEOUT_MS=60000
TIT_DB_APPLICATION_NAME=tit-growth-source-worker
