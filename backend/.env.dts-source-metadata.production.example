# Offline, value-blind DTS source-profile metadata observer.
# This file intentionally contains no broker, account, password or database
# settings. The current CLI does not connect to DTS or PostgreSQL and does not
# ACK any consumer group.
TIT_DTS_SOURCE_METADATA_OBSERVER_ENABLED=false
TIT_DTS_SOURCE_METADATA_SOURCE_MODE=offline_jsonl

# Run one region per evidence artifact.
TIT_DTS_SOURCE_METADATA_REGION=ovs

# Reserve a system-generated DTS group ID dedicated to diagnostics. The formal
# subscription group is required only for fail-closed inequality validation.
# Neither value is written to the evidence output. They must never be equal.
TIT_DTS_SOURCE_METADATA_DIAGNOSTIC_GROUP_ID=
TIT_DTS_SOURCE_METADATA_FORMAL_GROUP_ID=
# If the current shell also has TIT_DTS_GROUP_ID, it must exactly match the
# formal group above; otherwise the observer fails closed.

# Both paths must be absolute paths in a restricted local working directory.
# The input can contain business values and must never enter Git or logs.
TIT_DTS_SOURCE_METADATA_INPUT_JSONL=
TIT_DTS_SOURCE_METADATA_OUTPUT=

TIT_DTS_SOURCE_METADATA_MAX_EVENTS=1000
TIT_DTS_SOURCE_METADATA_MAX_DURATION_SECONDS=300
