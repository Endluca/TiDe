set_real_ip_from ${TIDE_COMPANY_GATEWAY_CIDR};
real_ip_header X-Forwarded-For;
real_ip_recursive on;

upstream ops_web {
    server web:8080;
    keepalive 16;
}

upstream ops_api {
    server api:8010;
    keepalive 32;
}

upstream teacher_web {
    server teacher-web:8080;
    keepalive 16;
}

upstream teacher_api {
    server teacher-api:3000;
    keepalive 32;
}

geo $realip_remote_addr $request_from_company_gateway {
    default 0;
    ${TIDE_COMPANY_GATEWAY_CIDR} 1;
}

map "$request_from_company_gateway:$http_x_forwarded_proto" $upstream_forwarded_proto {
    default $scheme;
    "1:http" http;
    "1:https" https;
}

server {
    listen 8080 default_server;
    server_name _;
    server_tokens off;

    location = /_health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 404;
    }
}

server {
    listen 8080;
    server_name ${TIDE_OPS_HOST};
    server_tokens off;

    client_max_body_size 2m;

    location /api/ {
        proxy_pass http://ops_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Never append a client-supplied chain. real_ip only accepts the
        # company gateway, then this overwrites the upstream header with one
        # canonical client address.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $upstream_forwarded_proto;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_buffering on;
    }

    location / {
        proxy_pass http://ops_web;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $upstream_forwarded_proto;
    }
}

server {
    listen 8080;
    server_name ${TIDE_TEACHER_HOST};
    server_tokens off;

    # Support tickets allow three 8 MiB images plus multipart overhead.
    client_max_body_size 26m;

    location /api/ {
        proxy_pass http://teacher_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $upstream_forwarded_proto;
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_request_buffering off;
        proxy_buffering on;
    }

    location / {
        proxy_pass http://teacher_web;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $upstream_forwarded_proto;
    }
}
