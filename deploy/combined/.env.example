# Non-secret deployment coordinates. Keep database URLs, passwords, JWT keys,
# OSS credentials, and mail/AI credentials in protected role-specific env files.
TIDE_OPS_HOST=ops.example.com
TIDE_TEACHER_HOST=teacher.example.com
TIDE_EDGE_BIND_ADDRESS=127.0.0.1
TIDE_EDGE_HTTP_PORT=8080
TIDE_EDGE_NETWORK_SUBNET=172.29.0.0/24
TIDE_EDGE_PROXY_IP=172.29.0.2
# Edge 只信任这个公司网关源地址段提供的 X-Forwarded-*。同机网关使用
# 127.0.0.1/32；异机网关填写经防火墙限制的 RFC1918 源 IP/CIDR。
TIDE_COMPANY_GATEWAY_CIDR=127.0.0.1/32
TIDE_DATABASE_NAME=tit_growth

# Use absolute paths on the deployment host.
TIDE_OPS_ENV_FILE=/srv/tide/secrets/ops.production.env
TIDE_OPS_MIGRATION_ENV_FILE=/srv/tide/secrets/ops.migration.env
TIDE_TEACHER_ENV_FILE=/srv/tide/secrets/teacher.production.env
TIDE_TEACHER_MIGRATION_TARGET=0043_p_rel_execution_catalog
TIDE_TEACHER_REPO_PATH=/srv/tide/src/Tide_teachers_camp/teacher

# Deploy only a reviewed commit containing this teacher source directory.
# In the combined repository this is the Tide_teachers_camp commit; a separate
# teacher repository remains supported and uses its own commit.
TIDE_TEACHER_EXPECTED_COMMIT=REPLACE_WITH_REVIEWED_40_CHAR_COMMIT
TIDE_TEACHER_PUBLIC_ASSET_BASE_URL=https://tide-media.example.com

# Runtime connection budgets. Each teacher process currently creates both a
# TIDE pool and a SHIWEN read pool, so 5 means at most 10 connections.
TIT_API_WORKERS=2
TIT_API_DB_POOL_SIZE=5
TIT_API_DB_MAX_OVERFLOW=2
# fresh-start 只运行 V2 Domain/Outbox/Favorite，旧 SourceWide 保持关闭。
TIT_SOURCE_WIDE_ENABLED=false
# 默认失败关闭；false 仍计算积分/current criteria，但禁止新授予不可逆资格。
TIT_IRREVERSIBLE_QUALIFICATION_GRANTS_ENABLED=false
TIT_SOURCE_WORKER_DB_POOL_SIZE=1
TIT_SOURCE_WORKER_DB_MAX_OVERFLOW=0
TIT_TEACHER_DB_POOL_SIZE=5
TIT_TEACHER_MULTIPART_UPLOAD_MAX_CONCURRENCY=4
